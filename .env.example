# ─────────────────────────────────────────
# QuitaZAP — Variáveis de ambiente
# Copie para .env e preencha os valores reais.
# Nunca commite o .env de verdade.
# ─────────────────────────────────────────

# ── Banco de dados (Supabase Postgres) ────
# DATABASE_URL = pooler (pgbouncer, porta 6543) — usado em runtime.
# DIRECT_URL   = conexão direta (porta 5432) — usado por migrations.
DATABASE_URL=
DIRECT_URL=

# ── Autenticação admin ─────────────────────
# Login do fundador em /login. Preferir ContaAdmin (banco) quando já
# configurada — APP_SENHA é só o bootstrap inicial.
APP_SENHA=
NEXTAUTH_SECRET=

# ── Secrets de rotas internas (OBRIGATÓRIOS em produção — as rotas
# falham fechado, ou seja, recusam toda chamada, se estiverem ausentes) ──
CRON_SECRET=
CAKTO_SECRET=
ZAPI_WEBHOOK_SECRET=
COBRADOR_TOKEN_SECRET=

# ── WhatsApp (Z-API, provider padrão) ─────
# WHATSAPP_PROVIDER=zapi (padrão) | evolution
WHATSAPP_PROVIDER=
ZAPI_INSTANCE=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# ── WhatsApp (Evolution API, alternativo) ─
EVO_URL=
EVO_INSTANCE=
EVO_APIKEY=

# ── OpenAI ─────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_FINANCEIRO_INTENT_MODEL=
OPENAI_SALES_BOT_MODEL=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=
OPENAI_TTS_SPEED=

# ── Cakto (checkout/assinatura) ───────────
CAKTO_CUPOM=
NEXT_PUBLIC_CAKTO_URL=

# ── Push notifications (Web Push / VAPID) ─
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=

# ── Diversos ───────────────────────────────
NEXT_PUBLIC_SITE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Feature flags — deixar SEM valor (ou "false") em produção por padrão.
# ENABLE_TEST_ROUTES: já causou incidente de segurança quando ligada em
# produção (rotas de teste /api/test/** ficaram acessíveis publicamente).
# Só ligar manualmente em ambiente de desenvolvimento, nunca em prod.
ENABLE_TEST_ROUTES=
FEATURE_AUDIO_REMINDERS=
