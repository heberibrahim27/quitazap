// QuitaZAP - Schema Prisma
// Banco: PostgreSQL (Supabase)

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────
// CLIENTE
// ─────────────────────────────────────────
// statusAtendimento: NOVO | AGUARDANDO_INFORMACOES | PLANO_GERADO | ACOMPANHAMENTO | ENCERRADO
model Cliente {
  id                    String    @id @default(cuid())
  nome                  String
  telefone              String
  cpf                   String?
  email                 String?
  obs                   String?
  senhaHash             String?
  fotoUrl               String?
  statusAtendimento     String    @default("NOVO")
  rendaMensal           Float?
  despesasFixas         Float?
  valorDisponivelMensal Float?
  gratuito              Boolean   @default(false)
  assinaturaVenceEm     DateTime?
  criadoEm              DateTime  @default(now())
  atualizadoEm          DateTime  @updatedAt

  dividas           Divida[]
  pagamentos        Pagamento[]
  planosEnviados    PlanoEnviado[]
  botSessoes        BotSessao[]
  cobrancas         Cobranca[]
  tarefas           Tarefa[]
  lancamentos       Lancamento[]
  cartoes           Cartao[]
  pushSubscriptions PushSubscription[]
  orcamentos        OrcamentoCategoria[]
  metas             Meta[]
  eventosCakto      EventoCakto[]
}

// ─────────────────────────────────────────
// METAS (cofrinhos)
// ─────────────────────────────────────────
// Meta com valor-alvo (ex: "Trocar de carro", R$15.000) e um histórico de
// depósitos — o "guardado" é sempre a soma dos depósitos, nunca um campo
// solto, pra nunca dessincronizar do extrato de depósitos mostrado na tela.
model Meta {
  id           String   @id @default(cuid())
  clienteId    String
  nome         String
  valorAlvo    Float
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  cliente   Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  depositos DepositoMeta[]

  @@index([clienteId])
}

// valor positivo = depósito (guardando), negativo = saque (resgatando) —
// soma direto vira o "guardado" da meta sem precisar de outro campo pra
// distinguir os dois casos. lancamentoId aponta pro Lancamento espelho
// (RECEITA no saque, DESPESA_VARIAVEL no depósito) que faz esse valor
// entrar/sair do saldo disponível do mês — sem isso, guardar numa meta não
// tirava dinheiro de lugar nenhum na visão geral do app.
model DepositoMeta {
  id           String   @id @default(cuid())
  metaId       String
  valor        Float
  data         DateTime @default(now())
  criadoEm     DateTime @default(now())
  lancamentoId String?  @unique

  meta       Meta        @relation(fields: [metaId], references: [id], onDelete: Cascade)
  lancamento Lancamento? @relation(fields: [lancamentoId], references: [id], onDelete: SetNull)

  @@index([metaId])
}

// ─────────────────────────────────────────
// ORÇAMENTO POR CATEGORIA
// ─────────────────────────────────────────
// Limite mensal opcional que o cliente define por categoria (mesmas
// categorias de src/lib/gasto-flow.ts). Um valor por categoria — se ele
// redefinir, substitui o anterior (não é histórico mês a mês).
model OrcamentoCategoria {
  id           String   @id @default(cuid())
  clienteId    String
  categoria    String
  limiteMensal Float
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([clienteId, categoria])
}

// ─────────────────────────────────────────
// PUSH SUBSCRIPTION (notificações do PWA)
// ─────────────────────────────────────────
// Uma linha por navegador/dispositivo inscrito (o mesmo cliente pode ter
// vários: celular + desktop, por exemplo). endpoint é único por inscrição
// (a própria URL do provedor de push já identifica o dispositivo).
model PushSubscription {
  id        String   @id @default(cuid())
  clienteId String
  endpoint  String   @unique
  p256dh    String
  auth      String
  criadoEm  DateTime @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
}

// ─────────────────────────────────────────
// DÍVIDA
// ─────────────────────────────────────────
// tipo:      CARTAO | EMPRESTIMO | BOLETO | ACORDO | OUTRO
// status:    ATIVA  | QUITADA    | NEGOCIANDO
// prioridade: 1 = mais urgente, 0 = sem prioridade definida
model Divida {
  id             String    @id @default(cuid())
  clienteId      String
  credor         String
  descricao      String?
  obs            String?
  valorTotal     Float
  valorPago      Float     @default(0)
  tipo           String    @default("OUTRO")
  status         String    @default("ATIVA")
  prioridade     Int       @default(0)
  totalParcelas  Int? // quantidade total de parcelas, quando aplicável (empréstimo, financiamento)
  diaVencimento  Int?
  emAtraso       Boolean   @default(false)
  diasAtraso     Int?
  dataReferencia DateTime?
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt

  cliente    Cliente     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  parcelas   Parcela[]
  pagamentos Pagamento[]
  tarefas    Tarefa[]
}

// ─────────────────────────────────────────
// PARCELA
// ─────────────────────────────────────────
// status: PENDENTE | PAGA | VENCIDA | CANCELADA
model Parcela {
  id           String   @id @default(cuid())
  dividaId     String
  numero       Int
  valor        Float
  vencimento   DateTime
  status       String   @default("PENDENTE")
  obs          String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  divida Divida @relation(fields: [dividaId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────
// PAGAMENTO
// ─────────────────────────────────────────
model Pagamento {
  id           String   @id @default(cuid())
  dividaId     String
  clienteId    String
  valor        Float
  data         DateTime
  obs          String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  divida  Divida  @relation(fields: [dividaId], references: [id], onDelete: Cascade)
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────
// PLANO ENVIADO
// ─────────────────────────────────────────
model PlanoEnviado {
  id        String   @id @default(cuid())
  clienteId String
  texto     String
  criadoEm  DateTime @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────
// BOT SESSAO (conversa WhatsApp)
// ─────────────────────────────────────────
// etapa: COLETANDO_DIVIDAS | AGUARDANDO_RENDA | PLANO_GERADO
model BotSessao {
  id           String   @id @default(cuid())
  telefone     String   @unique
  clienteId    String?
  etapa        String   @default("COLETANDO_DIVIDAS")
  nome         String?
  dividasTemp  String   @default("[]") // JSON: [{texto, valor, parcelas}]
  renda        Float?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
}

// ─────────────────────────────────────────
// MENSAGEM PROCESSADA (dedupe do webhook Z-API)
// ─────────────────────────────────────────
// Segunda camada de deduplicação, além do Map em memória em route.ts (que
// guarda messageId → instante em que foi visto). O Map sozinho não sobrevive
// a cold start nem funciona entre múltiplas instâncias serverless — esta
// tabela cobre exatamente esses casos. O código trata qualquer erro nesta
// camada (tabela ainda não migrada, banco fora do ar) como "não é duplicata"
// — nunca bloqueia uma mensagem legítima por falha aqui. Limpeza de linhas
// velhas roda dentro do cron /api/cron/tarefas (retenção de 24h).
model MensagemProcessada {
  id        String   @id @default(cuid())
  messageId String   @unique
  criadoEm  DateTime @default(now())
}

// ─────────────────────────────────────────
// LEAD DE VENDAS (funil Instagram/Facebook)
// ─────────────────────────────────────────
// etapa: QUALIFICACAO | PROVA | OFERTA | FOLLOWUP | CONVERTIDO | DESISTIU
model LeadVendas {
  id           String   @id @default(cuid())
  telefone     String   @unique
  nome         String?
  etapa        String   @default("QUALIFICACAO")
  cupomEnviado Boolean  @default(false)
  msgCount     Int      @default(0)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

// ─────────────────────────────────────────
// COBRANÇA (Cobrador Automático Pessoal)
// ─────────────────────────────────────────
// status: PENDENTE | ENVIADA | PAGA | CANCELADA
// etapa:  1=amigável, 2=firme, 3=última chance
model Cobranca {
  id           String    @id @default(cuid())
  clienteId    String
  credorNome   String // nome do assinante que cobra (ex: "Ibrahim")
  devedorNome  String // nome de quem deve
  devedorFone  String // whatsapp de quem deve (com DDI)
  valor        Float
  vencimento   DateTime
  mensagem     String? // mensagem personalizada do credor
  pixChave     String? // chave pix do credor (default: telefone do credor)
  status       String    @default("PENDENTE")
  etapa        Int       @default(1)
  tentativas   Int       @default(0)
  ultimoEnvio  DateTime?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────
// TAREFA (QuitaZAP Controle)
// Lembretes e pagamentos registrados por áudio/texto no WhatsApp.
// ─────────────────────────────────────────
// tipo:       LEMBRETE | PAGAMENTO
// status:     PENDENTE | CONCLUIDA | CANCELADA
// origem:     TEXTO | AUDIO
// frequencia (só quando recorrente=true): MENSAL | SEMANAL | ANUAL
// diaMes:     1-31, usado quando frequencia = MENSAL ou ANUAL
// mesAnual:   1-12, usado quando frequencia = ANUAL (junto com diaMes) — guardado
//             à parte do `vencimento` pra recorrência não ficar presa a uma data
//             já clampada (ex: 29/02 num ano não bissexto)
// diaSemana:  0 (domingo) a 6 (sábado), usado quando frequencia = SEMANAL
// dividaId:   preenchido quando o texto foi casado com uma Divida ATIVA do cliente
//             (por nome do credor); usado para reconciliar o pagamento com a dívida
model Tarefa {
  id             String    @id @default(cuid())
  clienteId      String
  tipo           String    @default("LEMBRETE")
  descricao      String
  valor          Float?
  vencimento     DateTime?
  recorrente     Boolean   @default(false)
  frequencia     String?
  diaMes         Int?
  mesAnual       Int?
  diaSemana      Int?
  horarioEnvio   String    @default("08:00")
  dividaId       String?
  status         String    @default("PENDENTE")
  origem         String    @default("TEXTO")
  concluidaEm    DateTime?
  ultimoLembrete DateTime?
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  divida  Divida? @relation(fields: [dividaId], references: [id], onDelete: SetNull)

  @@index([clienteId, status])
  @@index([vencimento])
}

// ─────────────────────────────────────────
// CARTÃO (QuitaZAP Controle)
// ─────────────────────────────────────────
model Cartao {
  id            String   @id @default(cuid())
  clienteId     String
  nome          String
  diaFechamento Int?
  diaVencimento Int?
  limite        Float?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  cliente     Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  lancamentos Lancamento[]

  @@unique([clienteId, nome])
}

// ─────────────────────────────────────────
// LANÇAMENTO (QuitaZAP Controle)
// Substitui o estado hoje só guardado em BotSessao.dividasTemp (JSON) por
// registros relacionais de verdade — renda, despesa fixa, despesa variável e
// compra no cartão, todos numa tabela só, filtráveis por mês/categoria.
// ─────────────────────────────────────────
// tipo:      RECEITA | DESPESA_FIXA | DESPESA_VARIAVEL | COMPRA_CARTAO | FATURA_FECHADA
//            (FATURA_FECHADA é só um marcador de "fechei a fatura em R$X" —
//            não soma no total de saídas, que já é coberto pelas linhas
//            individuais de COMPRA_CARTAO daquele cartão)
// categoria: mesmas categorias de src/lib/gasto-flow.ts (Mercado, Alimentação,
//            Transporte, Moradia, Contas da casa, ...), quando aplicável
// origem:    TEXTO | AUDIO | FOTO
model Lancamento {
  id             String   @id @default(cuid())
  clienteId      String
  tipo           String
  descricao      String
  categoria      String?
  valor          Float
  data           DateTime
  recorrente     Boolean  @default(false)
  cartaoId       String?
  origem         String   @default("TEXTO")
  comprovanteUrl String?
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  cliente      Cliente       @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  cartao       Cartao?       @relation(fields: [cartaoId], references: [id], onDelete: SetNull)
  depositoMeta DepositoMeta?

  @@index([clienteId, data])
  @@index([clienteId, tipo])
}

// ═════════════════════════════════════════
// QUITAZAP RECEBER — Modelos novos (multi-tenant)
// Sistema separado dos modelos legados acima
// ═════════════════════════════════════════

// ─────────────────────────────────────────
// USUARIO (dono da conta QuitaZAP Receber)
// ─────────────────────────────────────────
model Usuario {
  id                String    @id @default(cuid())
  nome              String
  email             String    @unique
  senhaHash         String
  telefone          String?
  // Plano: GRATUITO | RECEBER_BASICO | RECEBER_PRO | RECEBER_PREMIUM | CONTROLE
  plano             String    @default("GRATUITO")
  planoPago         Boolean   @default(false)
  assinaturaId      String?
  assinaturaVenceEm DateTime?
  gratuito          Boolean   @default(false)
  // WhatsApp Business
  wpInstancia       String?
  wpConectado       Boolean   @default(false)
  wpTelefone        String?
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt

  contatos      ContatoReceber[]
  pendencias    Pendencia[]
  configuracoes ConfigUsuario?
  enviosBot     EnvioBot[]
}

// ─────────────────────────────────────────
// CONTATO (pagador/devedor do usuário)
// ─────────────────────────────────────────
model ContatoReceber {
  id        String   @id @default(cuid())
  usuarioId String
  nome      String
  telefone  String
  email     String?
  documento String?
  obs       String?
  criadoEm  DateTime @default(now())

  usuario    Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  pendencias Pendencia[]

  @@unique([usuarioId, telefone])
}

// ─────────────────────────────────────────
// PENDÊNCIA (cobrança/lembrete de pagamento)
// ─────────────────────────────────────────
model Pendencia {
  id                String    @id @default(cuid())
  usuarioId         String
  contatoId         String?
  // Dados
  descricao         String
  // tipo: VENDA_FIADA | SERVICO | PARCELA | MENSALIDADE | ALUGUEL | OUTRO
  tipo              String    @default("OUTRO")
  valor             Float
  vencimento        DateTime
  // Pagamento
  // formaPagto: PIX_CHAVE | PIX_QR | PIX_LINK | MANUAL | SEM_PAGAMENTO_ONLINE
  formaPagto        String?
  pixChave          String?
  linkSlug          String?   @unique
  // Status: RASCUNHO | AGENDADA | ENVIADA | ENTREGUE | LIDA | LINK_ABERTO
  //         | RESPONDIDA | AGUARDANDO_PAGAMENTO | PAGAMENTO_INICIADO
  //         | PAGA | PARCIALMENTE_PAGA | VENCIDA | PAUSADA | CANCELADA | FALHOU
  status            String    @default("RASCUNHO")
  etapa             Int       @default(1)
  tentativas        Int       @default(0)
  enviarEm          DateTime?
  ultimoEnvio       DateTime?
  reguaPausada      Boolean   @default(false)
  // Pagamento registrado
  valorPago         Float?
  pagoEm            DateTime?
  comprovante       String?
  confirmacaoManual Boolean   @default(false)
  // Mensagem personalizada
  mensagemCustom    String?
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt

  usuario Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  contato ContatoReceber? @relation(fields: [contatoId], references: [id], onDelete: SetNull)
  envios  EnvioBot[]
}

// ─────────────────────────────────────────
// ENVIO BOT (cada mensagem enviada)
// ─────────────────────────────────────────
model EnvioBot {
  id          String   @id @default(cuid())
  usuarioId   String
  pendenciaId String
  etapa       Int
  mensagem    String
  enviadoEm   DateTime @default(now())
  // status: ENVIADO | ENTREGUE | LIDO | RESPONDIDO | FALHOU
  status      String   @default("ENVIADO")
  resposta    String?

  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  pendencia Pendencia @relation(fields: [pendenciaId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────
// CONFIGURAÇÕES DO USUÁRIO
// ─────────────────────────────────────────
model ConfigUsuario {
  id            String  @id @default(cuid())
  usuarioId     String  @unique
  nomeNegocio   String?
  horarioEnvio  String  @default("08:00")
  fusoHorario   String  @default("America/Bahia")
  resumoDiario  Boolean @default(true)
  resumoSemanal Boolean @default(true)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────
// LOG DE CONSUMO DE IA
// ─────────────────────────────────────────
model LogIA {
  id           String   @id @default(cuid())
  clienteId    String?
  gratuito     Boolean  @default(false)
  tipo         String // "chat" | "whisper" | "vision"
  tokensInput  Int      @default(0)
  tokensOutput Int      @default(0)
  custoUSD     Float    @default(0)
  criadoEm     DateTime @default(now())
}

// ─────────────────────────────────────────
// LOGIN DO FUNDADOR (painel admin)
// ─────────────────────────────────────────
// Uma linha só (é sempre o mesmo dono). Existe pra ele poder definir/trocar
// a própria senha pelo painel em vez de mexer direto na Vercel — enquanto
// não existir nenhuma linha, o login continua aceitando a senha da variável
// de ambiente APP_SENHA (bootstrap, compatível com o que já está em uso).
model ContaAdmin {
  id           String   @id @default(cuid())
  senhaHash    String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

// ─────────────────────────────────────────
// PAINEL FINANCEIRO — custos e metas
// ─────────────────────────────────────────
// Custo lançado manualmente pelo fundador (assinatura da Z-API, domínio,
// IA, hospedagem, etc). "mes" no formato YYYY-MM.
model CustoMensal {
  id           String   @id @default(cuid())
  mes          String
  categoria    String
  descricao    String?
  valor        Float
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([mes])
}

// Meta financeira simples: 1 alvo por métrica (nova substitui a anterior).
// metrica: "clientes_pagos" | "mrr"
model MetaFinanceira {
  id           String    @id @default(cuid())
  metrica      String    @unique
  valorAlvo    Float
  dataAlvo     DateTime?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
}

// ─────────────────────────────────────────
// EVENTO CAKTO — histórico bruto de webhook (base da receita real)
// ─────────────────────────────────────────
// Antes desta tabela, o webhook (api/webhook/cakto/route.ts) só reagia a
// "purchase_approved" e nunca gravava o valor pago em lugar nenhum — a
// receita no /financeiro e /painel era só contagem de Cliente pagante ×
// preço fixo hardcoded, sem refletir desconto, upgrade, reembolso ou
// chargeback nenhum. Esta tabela grava TODO evento recebido (não só
// aprovação), com o payload bruto sempre preservado — mesmo que o nome
// exato de um campo (valor, motivo) mude ou a extração abaixo erre, o
// dado original nunca se perde e dá pra reprocessar depois.
// status:      APROVADA | REEMBOLSADA | CANCELADA | CHARGEBACK | DESCONHECIDO
//              (classificado por padrão de texto em cima de `evento`, ver
//              classificarStatusCakto() no webhook — Cakto não tem schema
//              público confirmado nesta auditoria, então a classificação é
//              tolerante a variação de nome em vez de um enum fechado)
// valorPago:   best-effort a partir dos campos mais prováveis do payload
//              (amount/baseAmount/paidAmount/value) — null quando nenhum
//              bateu; NUNCA inventado. Unidade (reais vs. centavos) ainda
//              precisa ser confirmada com um payload real da Cakto.
model EventoCakto {
  id           String   @id @default(cuid())
  clienteId    String?
  evento       String
  status       String   @default("DESCONHECIDO")
  valorPago    Float?
  moeda        String   @default("BRL")
  transacaoId  String?  @unique
  payloadBruto Json
  criadoEm     DateTime @default(now())

  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  @@index([clienteId])
  @@index([evento])
  @@index([criadoEm])
}
