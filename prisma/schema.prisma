// QuitaZAP - Schema Prisma
// Banco: PostgreSQL (Supabase)

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────
// CLIENTE
// ─────────────────────────────────────────
// statusAtendimento: NOVO | AGUARDANDO_INFORMACOES | PLANO_GERADO | ACOMPANHAMENTO | ENCERRADO
model Cliente {
  id                    String    @id @default(cuid())
  nome                  String
  telefone              String
  cpf                   String?
  email                 String?
  obs                   String?
  senhaHash             String?
  fotoUrl               String?
  statusAtendimento     String    @default("NOVO")
  rendaMensal           Float?
  despesasFixas         Float?
  valorDisponivelMensal Float?
  // Horas trabalhadas por mês, opcional — quando não preenchido,
  // src/lib/financeiro/horas-trabalho.ts usa o padrão CLT de 220h/mês
  // (44h semanais, Súmula 431 TST) como estimativa.
  jornadaMensalHoras    Float?
  gratuito              Boolean   @default(false)
  assinaturaVenceEm     DateTime?
  // Cadastro de teste interno (Ibrahim, 2026-09-06) — ex: assinatura de
  // teste com familiar/equipe, sem pagamento real na Cakto. Nunca conta em
  // nenhum contador de "assinantes pagos" (dashboard, /financeiro,
  // /assinaturas, projeção — ver whereStatusAssinatura em
  // status-assinatura.ts e os pontos que fazem essa contagem por fora
  // dele), mas o cadastro continua existindo e visível no histórico —
  // nunca apagar um registro marcado como teste, só excluir das métricas.
  isTeste               Boolean   @default(false)
  // Consentimento pra mensagens proativas do sistema (lembrete de tarefa/
  // vencimento, avisos de novidade) — não afeta respostas do bot a algo que
  // o próprio cliente mandou, isso nunca é bloqueado por este campo.
  aceitaProativas       Boolean   @default(true)
  // Pedido do Ibrahim (09/09/2026): lembrete de vencimento/tarefa também
  // pode sair como nota de voz, não só texto — ver reminder-delivery.ts.
  // "TEXTO" (padrão, ninguém muda sem pedir) | "AUDIO" (só nota de voz,
  // cai pra texto se TTS/envio falhar) | "TEXTO_E_AUDIO" (manda os dois,
  // texto primeiro). Cliente troca mandando "lembrete em áudio"/"lembrete
  // em texto" no WhatsApp (ver detectarComandoModoLembrete no webhook).
  modoLembrete          String    @default("TEXTO")
  criadoEm              DateTime  @default(now())
  atualizadoEm          DateTime  @updatedAt

  dividas                   Divida[]
  pagamentos                Pagamento[]
  planosEnviados            PlanoEnviado[]
  botSessoes                BotSessao[]
  cobrancas                 Cobranca[]
  tarefas                   Tarefa[]
  lancamentos               Lancamento[]
  cartoes                   Cartao[]
  pushSubscriptions         PushSubscription[]
  orcamentos                OrcamentoCategoria[]
  metas                     Meta[]
  eventosCakto              EventoCakto[]
  insightsDetectados        InsightDetectado[]
  saudeFinanceiraLogs       SaudeFinanceiraLog[]
  mensagensPendentesRevisao MensagemPendenteRevisao[]
  documentosImportados      DocumentoImportado[]
}

// ─────────────────────────────────────────
// METAS (cofrinhos)
// ─────────────────────────────────────────
// Meta com valor-alvo (ex: "Trocar de carro", R$15.000) e um histórico de
// depósitos — o "guardado" é sempre a soma dos depósitos, nunca um campo
// solto, pra nunca dessincronizar do extrato de depósitos mostrado na tela.
model Meta {
  id           String   @id @default(cuid())
  clienteId    String
  nome         String
  valorAlvo    Float
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  cliente   Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  depositos DepositoMeta[]

  @@index([clienteId])
}

// valor positivo = depósito (guardando), negativo = saque (resgatando) —
// soma direto vira o "guardado" da meta sem precisar de outro campo pra
// distinguir os dois casos. lancamentoId aponta pro Lancamento espelho
// (RECEITA no saque, DESPESA_VARIAVEL no depósito) que faz esse valor
// entrar/sair do saldo disponível do mês — sem isso, guardar numa meta não
// tirava dinheiro de lugar nenhum na visão geral do app.
model DepositoMeta {
  id           String   @id @default(cuid())
  metaId       String
  valor        Float
  data         DateTime @default(now())
  criadoEm     DateTime @default(now())
  lancamentoId String?  @unique

  meta       Meta        @relation(fields: [metaId], references: [id], onDelete: Cascade)
  lancamento Lancamento? @relation(fields: [lancamentoId], references: [id], onDelete: SetNull)

  @@index([metaId])
}

// ─────────────────────────────────────────
// ORÇAMENTO POR CATEGORIA
// ─────────────────────────────────────────
// Limite mensal opcional que o cliente define por categoria (mesmas
// categorias de src/lib/gasto-flow.ts). Um valor por categoria — se ele
// redefinir, substitui o anterior (não é histórico mês a mês).
model OrcamentoCategoria {
  id           String   @id @default(cuid())
  clienteId    String
  categoria    String
  limiteMensal Float
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([clienteId, categoria])
}

// ─────────────────────────────────────────
// PUSH SUBSCRIPTION (notificações do PWA)
// ─────────────────────────────────────────
// Uma linha por navegador/dispositivo inscrito (o mesmo cliente pode ter
// vários: celular + desktop, por exemplo). endpoint é único por inscrição
// (a própria URL do provedor de push já identifica o dispositivo).
model PushSubscription {
  id        String   @id @default(cuid())
  clienteId String
  endpoint  String   @unique
  p256dh    String
  auth      String
  criadoEm  DateTime @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
}

// ─────────────────────────────────────────
// DÍVIDA
// ─────────────────────────────────────────
// tipo:      CARTAO | EMPRESTIMO | BOLETO | ACORDO | OUTRO
// status:    ATIVA  | QUITADA    | NEGOCIANDO
// prioridade: 1 = mais urgente, 0 = sem prioridade definida
model Divida {
  id                String    @id @default(cuid())
  clienteId         String
  credor            String
  descricao         String?
  obs               String?
  valorTotal        Float
  valorPago         Float     @default(0)
  tipo              String    @default("OUTRO")
  status            String    @default("ATIVA")
  prioridade        Int       @default(0)
  totalParcelas     Int? // quantidade total de parcelas, quando aplicável (empréstimo, financiamento)
  diaVencimento     Int?
  emAtraso          Boolean   @default(false)
  diasAtraso        Int?
  dataReferencia    DateTime?
  // true = consignado/desconto direto em folha (ex: contracheque de
  // servidor público). Essa parcela já está refletida no salário líquido
  // que o cliente lança/declara como renda — motor.ts e
  // saude-financeira.ts excluem essas parcelas do abatimento de
  // saldo/renda pra não contar o desconto duas vezes. Baixa automática
  // (ver cron consignados) marca como PAGA na data sem gerar nenhum
  // evento de abatimento, já que o dinheiro nunca "saiu" de um saldo
  // controlado pelo app.
  descontadoEmFolha Boolean   @default(false)
  // Cartão de origem, só quando tipo="CARTAO" E a dívida veio de uma compra
  // parcelada identificável a um cartão específico (hoje: importação de
  // fatura em PDF — ver fatura-cartao-flow.ts). Compra parcelada declarada
  // por TEXTO ("comprei uma TV em 10x") continua sem cartaoId (o cliente
  // raramente informa qual cartão nesse fluxo) — nullable de propósito,
  // não retroagir pras dívidas antigas.
  cartaoId          String?
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt

  cliente    Cliente     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  cartao     Cartao?     @relation(fields: [cartaoId], references: [id], onDelete: SetNull)
  parcelas   Parcela[]
  pagamentos Pagamento[]
  tarefas    Tarefa[]

  // Achado em auditoria de performance ao vivo (09/09/2026): sem índice
  // nenhum, toda busca de dívida por cliente (praticamente toda mensagem
  // do WhatsApp que toca em dívida/plano/resumo — motor.ts, plano-
  // pagamento-motor.ts, comandos RESUMO_MES/QUITASCORE etc.) fazia table
  // scan completo, piorando conforme a base de clientes cresce. Mesmo
  // padrão de índice que Lancamento já tem (@@index([clienteId, data])).
  @@index([clienteId, status])
}

// ─────────────────────────────────────────
// PARCELA
// ─────────────────────────────────────────
// status: PENDENTE | PAGA | VENCIDA | CANCELADA
model Parcela {
  id           String   @id @default(cuid())
  dividaId     String
  numero       Int
  valor        Float
  vencimento   DateTime
  status       String   @default("PENDENTE")
  obs          String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  divida Divida @relation(fields: [dividaId], references: [id], onDelete: Cascade)

  // Mesmo achado de performance do índice em Divida acima: toda dívida
  // busca suas parcelas pendentes (plano de pagamento, resumo financeiro,
  // motor de prioridade) filtrando por dividaId+status — sem índice,
  // table scan em Parcela a cada mensagem que toca nisso.
  @@index([dividaId, status])
}

// ─────────────────────────────────────────
// PAGAMENTO
// ─────────────────────────────────────────
model Pagamento {
  id           String   @id @default(cuid())
  dividaId     String
  clienteId    String
  valor        Float
  data         DateTime
  obs          String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  divida  Divida  @relation(fields: [dividaId], references: [id], onDelete: Cascade)
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────
// PLANO ENVIADO
// ─────────────────────────────────────────
model PlanoEnviado {
  id        String   @id @default(cuid())
  clienteId String
  texto     String
  criadoEm  DateTime @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────
// BOT SESSAO (conversa WhatsApp)
// ─────────────────────────────────────────
// etapa: COLETANDO_DIVIDAS | AGUARDANDO_RENDA | PLANO_GERADO
model BotSessao {
  id             String   @id @default(cuid())
  telefone       String   @unique
  clienteId      String?
  etapa          String   @default("COLETANDO_DIVIDAS")
  nome           String?
  dividasTemp    String   @default("[]") // JSON: [{texto, valor, parcelas}]
  renda          Float?
  // Boleto extraído de PDF aguardando confirmação (sim/não) do cliente pra
  // virar Divida — ver src/lib/boleto-flow.ts. Campo isolado de propósito,
  // não entra no dividasTemp/confirmacaoPendente do fluxo de texto (são
  // preocupações diferentes: confirmação de documento vs. continuação de
  // conversa em texto).
  boletoPendente Json?
  // Fatura de cartão extraída de PDF aguardando confirmação — ver
  // src/lib/fatura-cartao-flow.ts. Guarda: cartão resolvido, fila de
  // compras parecidas com dívida já existente (aguardando sim/não uma por
  // uma, pra nunca duplicar o mesmo parcelamento entre faturas de meses
  // diferentes) e, depois, a lista final aguardando confirmação em lote.
  // Campo isolado do boletoPendente de propósito (mesmo motivo do
  // comentário acima: tipos de documento e schemas de confirmação
  // diferentes).
  faturaCartaoPendente Json?
  // Comprovante de compra (foto) com loja/valor extraído por IA de visão,
  // aguardando confirmação (sim/não) antes de virar Lancamento — ver
  // src/lib/comprovante-foto-flow.ts. Campo isolado dos dois acima de
  // propósito (mesmo motivo: tipos de origem e schemas de confirmação
  // diferentes).
  comprovanteFotoPendente Json?
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
}

// ─────────────────────────────────────────
// MENSAGEM PROCESSADA (dedupe do webhook Z-API)
// ─────────────────────────────────────────
// Segunda camada de deduplicação, além do Map em memória em route.ts (que
// guarda messageId → instante em que foi visto). O Map sozinho não sobrevive
// a cold start nem funciona entre múltiplas instâncias serverless — esta
// tabela cobre exatamente esses casos. O código trata qualquer erro nesta
// camada (tabela ainda não migrada, banco fora do ar) como "não é duplicata"
// — nunca bloqueia uma mensagem legítima por falha aqui. Limpeza de linhas
// velhas roda dentro do cron /api/cron/tarefas (retenção de 24h).
model MensagemProcessada {
  id        String   @id @default(cuid())
  messageId String   @unique
  criadoEm  DateTime @default(now())
}

// ─────────────────────────────────────────
// DOCUMENTO IMPORTADO (dedupe de PDF já processado)
// ─────────────────────────────────────────
// Guarda o hash (SHA-256) de cada PDF cujas informações já viraram
// lançamento/dívida, pra nunca reprocessar o MESMO arquivo duas vezes se o
// cliente reenviar por engano (ver fatura-cartao-flow.ts). Só grava depois
// de uma importação confirmada pelo cliente (sim) — se ele cancelar (não),
// não grava, pra permitir reenviar/tentar de novo depois.
model DocumentoImportado {
  id        String   @id @default(cuid())
  clienteId String
  hash      String
  tipo      String // ex: "FATURA_CARTAO"
  criadoEm  DateTime @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([clienteId, hash])
}

// ─────────────────────────────────────────
// LEAD DE VENDAS (funil Instagram/Facebook)
// ─────────────────────────────────────────
// etapa: QUALIFICACAO | PROVA | OFERTA | FOLLOWUP | CONVERTIDO | DESISTIU
model LeadVendas {
  id                String   @id @default(cuid())
  telefone          String   @unique
  nome              String?
  etapa             String   @default("QUALIFICACAO")
  cupomEnviado      Boolean  @default(false)
  msgCount          Int      @default(0)
  // Loop de reversão de objeção (Ibrahim, 2026-09-06): quantas vezes já
  // tentamos reverter uma objeção com um ângulo diferente, e quais ângulos
  // (PRECO/CONFIANCA/CANCELAMENTO/CONCORRENTE/ADIAR, separados por vírgula)
  // já foram usados — pra nunca repetir o mesmo argumento pro mesmo lead.
  // Zerado de novo depois que o lead compra ou desiste de vez.
  tentativasObjecao Int      @default(0)
  angulosUsados     String   @default("")
  // Por que etapa virou DESISTIU (pedido do Ibrahim: painel admin precisa
  // distinguir "pediu pra parar" de "só sumiu"/"esgotou as objeções") —
  // null enquanto o lead ainda está ativo ou converteu.
  // OPTOUT = pediu explicitamente pra parar (RE_PARAR)
  // RECUSOU = recusou logo na abertura/demonstração (ehRecusaClara)
  // OBJECAO_ESGOTADA = não aceitou depois de esgotar as rodadas de objeção
  motivoDesistencia String?
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt

  mensagens MensagemLeadVendas[]
}

// Histórico completo da conversa do funil de vendas (pedido do Ibrahim:
// painel admin pra acompanhar atendimento por lead). Uma linha por
// mensagem — nunca sobrescreve, só acrescenta — ao contrário do
// BotSessao.dividasTemp (usado pelo bot de assinante), que é um blob JSON
// mutável de working-memory, não um log de auditoria.
model MensagemLeadVendas {
  id       String   @id @default(cuid())
  leadId   String
  direcao  String // "LEAD" | "BOT"
  texto    String
  criadoEm DateTime @default(now())

  lead LeadVendas @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, criadoEm])
}

// ─────────────────────────────────────────
// COBRANÇA (Cobrador Automático Pessoal)
// ─────────────────────────────────────────
// status: PENDENTE | ENVIADA | PAGA | CANCELADA
// etapa:  1=amigável, 2=firme, 3=última chance
model Cobranca {
  id           String    @id @default(cuid())
  clienteId    String
  credorNome   String // nome do assinante que cobra (ex: "Ibrahim")
  devedorNome  String // nome de quem deve
  devedorFone  String // whatsapp de quem deve (com DDI)
  valor        Float
  vencimento   DateTime
  mensagem     String? // mensagem personalizada do credor
  pixChave     String? // chave pix do credor (default: telefone do credor)
  status       String    @default("PENDENTE")
  etapa        Int       @default(1)
  tentativas   Int       @default(0)
  ultimoEnvio  DateTime?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────
// TAREFA (QuitaZAP Controle)
// Lembretes e pagamentos registrados por áudio/texto no WhatsApp.
// ─────────────────────────────────────────
// tipo:       LEMBRETE | PAGAMENTO
// status:     PENDENTE | CONCLUIDA | CANCELADA
// origem:     TEXTO | AUDIO
// frequencia (só quando recorrente=true): MENSAL | SEMANAL | ANUAL
// diaMes:     1-31, usado quando frequencia = MENSAL ou ANUAL
// mesAnual:   1-12, usado quando frequencia = ANUAL (junto com diaMes) — guardado
//             à parte do `vencimento` pra recorrência não ficar presa a uma data
//             já clampada (ex: 29/02 num ano não bissexto)
// diaSemana:  0 (domingo) a 6 (sábado), usado quando frequencia = SEMANAL
// dividaId:   preenchido quando o texto foi casado com uma Divida ATIVA do cliente
//             (por nome do credor); usado para reconciliar o pagamento com a dívida
model Tarefa {
  id             String    @id @default(cuid())
  clienteId      String
  tipo           String    @default("LEMBRETE")
  descricao      String
  valor          Float?
  vencimento     DateTime?
  recorrente     Boolean   @default(false)
  frequencia     String?
  diaMes         Int?
  mesAnual       Int?
  diaSemana      Int?
  horarioEnvio   String    @default("08:00")
  dividaId       String?
  status         String    @default("PENDENTE")
  origem         String    @default("TEXTO")
  concluidaEm    DateTime?
  ultimoLembrete DateTime?
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  divida  Divida? @relation(fields: [dividaId], references: [id], onDelete: SetNull)

  @@index([clienteId, status])
  @@index([vencimento])
}

// ─────────────────────────────────────────
// CARTÃO (QuitaZAP Controle)
// ─────────────────────────────────────────
model Cartao {
  id            String   @id @default(cuid())
  clienteId     String
  nome          String
  diaFechamento Int?
  diaVencimento Int?
  limite        Float?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  cliente     Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  lancamentos Lancamento[]
  dividas     Divida[]

  @@unique([clienteId, nome])
}

// ─────────────────────────────────────────
// LANÇAMENTO (QuitaZAP Controle)
// Substitui o estado hoje só guardado em BotSessao.dividasTemp (JSON) por
// registros relacionais de verdade — renda, despesa fixa, despesa variável e
// compra no cartão, todos numa tabela só, filtráveis por mês/categoria.
// ─────────────────────────────────────────
// tipo:      RECEITA | DESPESA_FIXA | DESPESA_VARIAVEL | COMPRA_CARTAO | FATURA_FECHADA
//            (FATURA_FECHADA é só um marcador de "fechei a fatura em R$X" —
//            não soma no total de saídas, que já é coberto pelas linhas
//            individuais de COMPRA_CARTAO daquele cartão)
// categoria: mesmas categorias de src/lib/gasto-flow.ts (Mercado, Alimentação,
//            Transporte, Moradia, Contas da casa, ...), quando aplicável
// origem:    TEXTO | AUDIO | FOTO
model Lancamento {
  id             String   @id @default(cuid())
  clienteId      String
  tipo           String
  descricao      String
  categoria      String?
  valor          Float
  data           DateTime
  recorrente     Boolean  @default(false)
  cartaoId       String?
  origem         String   @default("TEXTO")
  comprovanteUrl String?
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  cliente      Cliente       @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  cartao       Cartao?       @relation(fields: [cartaoId], references: [id], onDelete: SetNull)
  depositoMeta DepositoMeta?

  @@index([clienteId, data])
  @@index([clienteId, tipo])
}

// ═════════════════════════════════════════
// QUITAZAP RECEBER — Modelos novos (multi-tenant)
// Sistema separado dos modelos legados acima
// ═════════════════════════════════════════

// ─────────────────────────────────────────
// USUARIO (dono da conta QuitaZAP Receber)
// ─────────────────────────────────────────
model Usuario {
  id                String    @id @default(cuid())
  nome              String
  email             String    @unique
  senhaHash         String
  telefone          String?
  // Plano: GRATUITO | RECEBER_BASICO | RECEBER_PRO | RECEBER_PREMIUM | CONTROLE
  plano             String    @default("GRATUITO")
  planoPago         Boolean   @default(false)
  assinaturaId      String?
  assinaturaVenceEm DateTime?
  gratuito          Boolean   @default(false)
  // WhatsApp Business
  wpInstancia       String?
  wpConectado       Boolean   @default(false)
  wpTelefone        String?
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt

  contatos      ContatoReceber[]
  pendencias    Pendencia[]
  configuracoes ConfigUsuario?
  enviosBot     EnvioBot[]
}

// ─────────────────────────────────────────
// CONTATO (pagador/devedor do usuário)
// ─────────────────────────────────────────
model ContatoReceber {
  id        String   @id @default(cuid())
  usuarioId String
  nome      String
  telefone  String
  email     String?
  documento String?
  obs       String?
  criadoEm  DateTime @default(now())

  usuario    Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  pendencias Pendencia[]

  @@unique([usuarioId, telefone])
}

// ─────────────────────────────────────────
// PENDÊNCIA (cobrança/lembrete de pagamento)
// ─────────────────────────────────────────
model Pendencia {
  id                String    @id @default(cuid())
  usuarioId         String
  contatoId         String?
  // Dados
  descricao         String
  // tipo: VENDA_FIADA | SERVICO | PARCELA | MENSALIDADE | ALUGUEL | OUTRO
  tipo              String    @default("OUTRO")
  valor             Float
  vencimento        DateTime
  // Pagamento
  // formaPagto: PIX_CHAVE | PIX_QR | PIX_LINK | MANUAL | SEM_PAGAMENTO_ONLINE
  formaPagto        String?
  pixChave          String?
  linkSlug          String?   @unique
  // Status: RASCUNHO | AGENDADA | ENVIADA | ENTREGUE | LIDA | LINK_ABERTO
  //         | RESPONDIDA | AGUARDANDO_PAGAMENTO | PAGAMENTO_INICIADO
  //         | PAGA | PARCIALMENTE_PAGA | VENCIDA | PAUSADA | CANCELADA | FALHOU
  status            String    @default("RASCUNHO")
  etapa             Int       @default(1)
  tentativas        Int       @default(0)
  enviarEm          DateTime?
  ultimoEnvio       DateTime?
  reguaPausada      Boolean   @default(false)
  // Pagamento registrado
  valorPago         Float?
  pagoEm            DateTime?
  comprovante       String?
  confirmacaoManual Boolean   @default(false)
  // Mensagem personalizada
  mensagemCustom    String?
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt

  usuario Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  contato ContatoReceber? @relation(fields: [contatoId], references: [id], onDelete: SetNull)
  envios  EnvioBot[]
}

// ─────────────────────────────────────────
// ENVIO BOT (cada mensagem enviada)
// ─────────────────────────────────────────
model EnvioBot {
  id          String   @id @default(cuid())
  usuarioId   String
  pendenciaId String
  etapa       Int
  mensagem    String
  enviadoEm   DateTime @default(now())
  // status: ENVIADO | ENTREGUE | LIDO | RESPONDIDO | FALHOU
  status      String   @default("ENVIADO")
  resposta    String?

  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  pendencia Pendencia @relation(fields: [pendenciaId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────
// CONFIGURAÇÕES DO USUÁRIO
// ─────────────────────────────────────────
model ConfigUsuario {
  id            String  @id @default(cuid())
  usuarioId     String  @unique
  nomeNegocio   String?
  horarioEnvio  String  @default("08:00")
  fusoHorario   String  @default("America/Bahia")
  resumoDiario  Boolean @default(true)
  resumoSemanal Boolean @default(true)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────
// LOG DE CONSUMO DE IA
// ─────────────────────────────────────────
model LogIA {
  id           String   @id @default(cuid())
  clienteId    String?
  gratuito     Boolean  @default(false)
  tipo         String // "chat" | "whisper" | "vision"
  tokensInput  Int      @default(0)
  tokensOutput Int      @default(0)
  custoUSD     Float    @default(0)
  criadoEm     DateTime @default(now())
}

// ─────────────────────────────────────────
// LOGIN DO FUNDADOR (painel admin)
// ─────────────────────────────────────────
// Uma linha só (é sempre o mesmo dono). Existe pra ele poder definir/trocar
// a própria senha pelo painel em vez de mexer direto na Vercel — enquanto
// não existir nenhuma linha, o login continua aceitando a senha da variável
// de ambiente APP_SENHA (bootstrap, compatível com o que já está em uso).
model ContaAdmin {
  id           String   @id @default(cuid())
  senhaHash    String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

// ─────────────────────────────────────────
// PAINEL FINANCEIRO — custos e metas
// ─────────────────────────────────────────
// Custo lançado manualmente pelo fundador (assinatura da Z-API, domínio,
// IA, hospedagem, etc). "mes" no formato YYYY-MM.
model CustoMensal {
  id           String   @id @default(cuid())
  mes          String
  categoria    String
  descricao    String?
  valor        Float
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([mes])
}

// Meta financeira simples: 1 alvo por métrica (nova substitui a anterior).
// metrica: "clientes_pagos" | "mrr"
model MetaFinanceira {
  id           String    @id @default(cuid())
  metrica      String    @unique
  valorAlvo    Float
  dataAlvo     DateTime?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
}

// ─────────────────────────────────────────
// MONITOR Z-API — detecta instância de WhatsApp desconectada e avisa
// ─────────────────────────────────────────
// Achado ao vivo (09/09/2026, Ibrahim: "bot não responde números diferentes
// do meu"): a instância Z-API do QuitaZAP estava (e talvez ainda esteja,
// dependendo do dia) desconectada do WhatsApp — sem ninguém checando, isso
// só aparece quando um cliente reclama. Ibrahim pediu uma solução pra não
// precisar ficar de olho na tela o tempo todo.
//
// Esta tabela guarda só o último estado conhecido de cada instância (1
// linha por instância — "quitazap" por enquanto, mas dá pra reusar pra
// outras no futuro). src/app/api/cron/zapi-status/route.ts lê o estado
// atual direto na Z-API, compara com o que tá salvo aqui, e só marca
// `alertar: true` na resposta quando o estado MUDOU (caiu agora, ou voltou
// agora) — assim quem chama esse endpoint periodicamente (ex: uma tarefa
// agendada) só manda aviso pro Ibrahim quando há algo novo, nunca em loop
// repetido enquanto o problema continua sem solução.
model MonitorZapi {
  id           String   @id @default(cuid())
  instancia    String   @unique // "quitazap"
  conectado    Boolean
  atualizadoEm DateTime @updatedAt
}

// ─────────────────────────────────────────
// MARKETING — investimento em aquisição paga (Ads)
// ─────────────────────────────────────────
// Pedido do Ibrahim (2026-09-06): tela /marketing pra projetar meses de
// investimento em Ads (CAC, MRR, resultado) e comparar projetado x real.
// MarketingParametros é uma linha só (mesmo padrão de ContaAdmin acima) —
// sem linha ainda, a tela usa os defaults do briefing.
model MarketingParametros {
  id                        String   @id @default(cuid())
  investimentoInicialMensal Float    @default(1000)
  cacProjetado              Float    @default(25)
  // Fração (0.15 = 15%), não percentual — mesmo padrão de COMISSAO_CAKTO.
  churnMensal               Float    @default(0.15)
  horizonteMeses            Int      @default(12)
  atualizadoEm              DateTime @updatedAt
}

// Dado real de um mês de campanha, informado manualmente pelo Ibrahim (sem
// integração automática com Meta/Instagram Ads por enquanto).
// novasAssinaturasPagas tem que ser confirmado pela Cakto — nunca lead,
// conversa ou clique.
model MarketingMesReal {
  id                    String   @id @default(cuid())
  mes                   String   @unique // "AAAA-MM"
  investimentoReal      Float
  novasAssinaturasPagas Int
  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt
}

// ─────────────────────────────────────────
// EVENTO CAKTO — histórico bruto de webhook (base da receita real)
// ─────────────────────────────────────────
// Antes desta tabela, o webhook (api/webhook/cakto/route.ts) só reagia a
// "purchase_approved" e nunca gravava o valor pago em lugar nenhum — a
// receita no /financeiro e /painel era só contagem de Cliente pagante ×
// preço fixo hardcoded, sem refletir desconto, upgrade, reembolso ou
// chargeback nenhum. Esta tabela grava TODO evento recebido (não só
// aprovação), com o payload bruto sempre preservado — mesmo que o nome
// exato de um campo (valor, motivo) mude ou a extração abaixo erre, o
// dado original nunca se perde e dá pra reprocessar depois.
// status:      APROVADA | REEMBOLSADA | CANCELADA | CHARGEBACK | DESCONHECIDO
//              (classificado por padrão de texto em cima de `evento`, ver
//              classificarStatusCakto() no webhook — Cakto não tem schema
//              público confirmado nesta auditoria, então a classificação é
//              tolerante a variação de nome em vez de um enum fechado)
// valorPago:   best-effort a partir dos campos mais prováveis do payload
//              (amount/baseAmount/paidAmount/value) — null quando nenhum
//              bateu; NUNCA inventado. Unidade (reais vs. centavos) ainda
//              precisa ser confirmada com um payload real da Cakto.
model EventoCakto {
  id           String   @id @default(cuid())
  clienteId    String?
  evento       String
  status       String   @default("DESCONHECIDO")
  valorPago    Float?
  moeda        String   @default("BRL")
  transacaoId  String?  @unique
  payloadBruto Json
  criadoEm     DateTime @default(now())

  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  @@index([clienteId])
  @@index([evento])
  @@index([criadoEm])
}

// ─────────────────────────────────────────
// INSIGHT DETECTADO — insight proativo (Skill Analista, prioridade 3)
// ─────────────────────────────────────────
// Detecção 100% determinística (src/lib/financeiro/deteccao-anomalia.ts,
// em cima do motor.ts) — a IA só é chamada pra REDIGIR o texto de um
// insight que já foi decidido por código, nunca pra decidir se dispara.
// Nasce em modo sombra (status SOMBRA): só fica registrado aqui pro
// fundador revisar em /insights-sombra antes de decidir ligar o envio de
// verdade (status ENVIADO, quando essa fase existir).
// tipo:   hoje só "ANOMALIA_CATEGORIA" (categoria do mês > 1.3x a média
//         dos últimos 3 meses) — campo aberto pra outros tipos futuros.
// status: SOMBRA | ENVIADO
// Único por (clienteId, categoria, mes): upsert idempotente no cron —
// nunca duplica nem gasta IA de novo pra reavaliar a mesma anomalia no
// mesmo mês.
model InsightDetectado {
  id                String   @id @default(cuid())
  clienteId         String
  tipo              String   @default("ANOMALIA_CATEGORIA")
  categoria         String
  mes               String // YYYY-MM
  totalMesAtual     Float
  mediaUltimosMeses Float
  multiplicador     Float
  textoGerado       String
  status            String   @default("SOMBRA")
  criadoEm          DateTime @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([clienteId, categoria, mes])
  @@index([clienteId])
  @@index([criadoEm])
}

// Histórico do score de Saúde Financeira (src/lib/financeiro/saude-financeira.ts).
// 1 registro por (clienteId, dia) — upsert a cada carregamento da Home do
// Controle, então múltiplas visitas no mesmo dia não duplicam, só atualizam
// pro valor mais recente daquele dia. versaoFormula grava qual fórmula
// gerou aquele score: se os pesos mudarem no futuro, o histórico antigo
// continua marcado com a versão que realmente o calculou, em vez de ser
// reinterpretado silenciosamente como se tivesse saído da fórmula nova.
model SaudeFinanceiraLog {
  id                 String   @id @default(cuid())
  clienteId          String
  dia                String // YYYY-MM-DD, calendário de Brasília
  versaoFormula      String
  score              Int
  classificacao      String
  dadosInsuficientes Boolean  @default(false)
  componentes        Json
  criadoEm           DateTime @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([clienteId, dia])
  @@index([clienteId])
}

// ─────────────────────────────────────────
// CONTATO SOCIAL (redes sociais / canais de suporte)
// ─────────────────────────────────────────
// Cadastro do fundador (via /painel/contatos) pros pontos públicos que
// antes tinham o WhatsApp pessoal dele hardcoded (rodapé da landing,
// política de privacidade, plano do Cobrador). `link` já vem normalizado
// (mailto:, https://wa.me/..., https://...) no momento da gravação — quem
// lê (landing, privacidade, cobrador) nunca reprocessa `valorBruto`, só
// usa `link` direto. Só itens com `ativo:true` aparecem em qualquer lugar
// público; sem nenhum ativo, o bloco correspondente some inteiro (sem
// ícone vazio, sem "#", sem link morto).
model ContatoSocial {
  id           String   @id @default(cuid())
  tipo         String // "WHATSAPP" | "INSTAGRAM" | "EMAIL" | "YOUTUBE" | "TIKTOK" | "OUTRO"
  nome         String // nome exibido (ex: "Suporte QuitaZap", "@quitazap")
  valorBruto   String // o que o fundador digitou (telefone, e-mail ou URL), sem normalizar
  link         String // link final já normalizado, pronto pra usar em href
  ativo        Boolean  @default(true)
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([ativo, ordem])
}

// ─────────────────────────────────────────
// AUDITORIA DO ASSISTENTE ADMIN (IA interna)
// ─────────────────────────────────────────
// Toda ação de ESCRITA que o assistente de IA do painel admin executa de
// fato (depois de confirmada pelo usuário — o assistente nunca executa
// direto, ver src/lib/assistente-admin/ferramentas.ts) grava uma linha
// aqui: qual ferramenta, com quais argumentos, o estado antes/depois, e se
// deu certo. Sem identidade individual por enquanto — o admin usa senha
// única compartilhada (ver ContaAdmin acima), não dá pra saber qual
// pessoa da equipe pediu; `solicitadoPor` fica reservado pra quando (ou
// se) existir login por pessoa.
model AuditoriaAssistente {
  id            String   @id @default(cuid())
  ferramenta    String
  argumentos    Json
  resumo        String
  antes         Json?
  depois        Json?
  sucesso       Boolean  @default(true)
  erro          String?
  solicitadoPor String?
  criadoEm      DateTime @default(now())

  @@index([ferramenta])
  @@index([criadoEm])
}

// ─────────────────────────────────────────
// MENSAGEM PENDENTE DE REVISÃO (fila do rescue parser)
// ─────────────────────────────────────────
// Quando o interpretador financeiro (src/lib/ia/financeiro-intent-resolver.ts)
// e o ai-bot.ts (rescue ladder, 3 tentativas) não conseguem entender uma
// mensagem com segurança suficiente, ela pára de tentar e cai aqui — nunca
// grava um lançamento/dívida/meta adivinhado. Fila só de leitura pro admin
// revisar quando quiser (ver /revisao-pendente); sem notificação automática
// por design (Ibrahim, 2026-09-06: "não me notificar direto toda vez").
// criticidade/categoria (Ibrahim, 2026-09-06): antes desta rodada, TODA
// mensagem que o rescue parser não entendia caía aqui como se precisasse
// de ação humana — "pensa em 10 mil clientes tendo que olhar
// manualmente". Agora o bot sempre resolve algo pro cliente na hora (ver
// rescue-classificador.ts) e só marca CRITICA quando é genuinamente
// cancelamento/reclamação grave/erro de cobrança/pedido de humano; o
// resto (MONITORAMENTO, default) é só dado pra melhorar o parser, não
// uma tarefa pendente de ninguém.
model MensagemPendenteRevisao {
  id          String    @id @default(cuid())
  clienteId   String?
  telefone    String?
  nome        String?
  mensagem    String
  motivo      String
  criticidade String    @default("MONITORAMENTO")
  categoria   String?
  resolvida   Boolean   @default(false)
  criadoEm    DateTime  @default(now())
  resolvidaEm DateTime?

  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  @@index([resolvida, criadoEm])
  @@index([clienteId])
  @@index([criticidade, resolvida, criadoEm])
}
